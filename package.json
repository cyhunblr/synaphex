{
  "name": "synaphex",
  "version": "0.1.0",
  "description": "Foundational project and session state for Synaphex",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/test/*.test.js",
    "test:mcp-stdio": "npm run test:compile && node --test .test-dist/test/mcp-stdio-smoke.test.js",
    "test:codex-live": "npm run test:compile && node .test-dist/test/live/codex-live.test.js",
    "test:codex-coder-web-search-live": "npm run test:compile && node .test-dist/test/live/codex-network-live.test.js",
    "test:codex-web-search-live": "npm run test:compile && node .test-dist/test/live/codex-web-search-live.test.js",
    "test:claude-live": "npm run test:compile && node .test-dist/test/live/claude-live.test.js",
    "test:claude-web-search-live": "npm run test:compile && node .test-dist/test/live/claude-web-search-live.test.js",
    "test:claude-coder-live": "npm run test:compile && node .test-dist/test/live/claude-coder-live.test.js",
    "test:antigravity-live": "npm run test:compile && node .test-dist/test/live/antigravity-live.test.js",
    "test:antigravity-coder-live": "npm run test:compile && node .test-dist/test/live/antigravity-coder-live.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "bin": {
    "synaphex": "./dist/installer/cli-main.js",
    "synaphex-mcp-stdio": "./dist/mcp/stdio-main.js"
  }
}
